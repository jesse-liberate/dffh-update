<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/trackemails/db" VERSION="20150626" COMMENT="XMLDB file for Moodle admin/tool/trackemails" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="trackemails" COMMENT="Track all emails from feature">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="tablename" TYPE="char" LENGTH="128" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="touserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="subject" TYPE="char" LENGTH="1024" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="htmlcontent" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="issent" TYPE="int" LENGTH="1" DEFAULT="0" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="note" TYPE="char" LENGTH="512" NOTNULL="false" SEQUENCE="false" COMMENT=""/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="index_trackemail_touserid" UNIQUE="false" FIELDS="touserid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>